# Copy to .env and fill in. `make check` verifies every credential.
# There is no database: pipeline state lives in the backend's memory and is
# lost on restart. See docs/setup.md, "State and persistence".

# --- OpenAI (https://platform.openai.com/api-keys) -----------------------
OPENAI_API_KEY=
# Must support structured outputs (json_schema). Any OpenAI-compatible
# endpoint works via OPENAI_BASE_URL.
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MAX_RETRIES=5

# --- Slack (Socket Mode; runs inside the backend process) ----------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# --- ClickUp (publishes the WBS, then monitors it) -----------------------
# Personal token (pk_...): ClickUp avatar -> Settings -> Apps.
CLICKUP_API_TOKEN=
# Open the Space in ClickUp; the URL ends /v/s/<SPACE_ID>.
CLICKUP_SPACE_ID=
# false: keep the WBS on the dashboard without publishing it.
CLICKUP_ENABLED=true
# Re-read published projects and log deviations from the plan.
MONITOR_ENABLED=true
# Seconds between checks (minimum 30; the free plan allows 100 requests/minute).
MONITOR_INTERVAL_SECONDS=300

# --- GitHub (where the generated prototype is committed) -----------------
GITHUB_TOKEN=
GITHUB_OWNER=

# --- Vercel --------------------------------------------------------------
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# --- Application ---------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# Dashboard logins live in users.json (hashed passwords only); add them with
# `make create-user u=<name>`. Setting DASHBOARD_PASSWORD also gives an "admin" login.
DASHBOARD_PASSWORD=changeme
# Off: the API answers anyone who can reach it (fine on localhost). On: every
# /api call needs a login token. Turn on before exposing the dashboard.
DASHBOARD_AUTH=false
# Signs login tokens. Empty: a random secret per process, so logins end on restart.
SESSION_SECRET=
# The only local data file. Default: repository root.
# USERS_FILE=users.json

# Optional: load the canned demo conversation into this channel at startup.
SEED_CHANNEL=
